#!/bin/sh
# Sitzung des Kioskmodus (siehe firebridge-kiosk): nur die Firebridge-Oberfläche, kein Desktop.
# Beendet sich die Oberfläche mit 0 („Kiosk verlassen“ mit Admin-Passwort), endet die Sitzung und
# LightDM zeigt die Anmeldung. Bei einem Absturz startet sie nach kurzer Pause neu.
PATH=/usr/local/bin:/usr/bin:/bin
export PATH
# Kein Bildschirmschoner, der eine Desktop-Sperre bräuchte; der Bildschirm darf trotzdem dunkel werden
xset s off 2>/dev/null || true
xsetroot -solid '#1f2a35' 2>/dev/null || true
fails=0
while :; do
    start=$(date +%s)
    firebridge-gui --kiosk
    rc=$?
    [ "$rc" -eq 0 ] && exit 0
    # Stürzt sie gleich wieder ab, nicht im Sekundentakt neu starten
    if [ $(( $(date +%s) - start )) -lt 10 ]; then fails=$((fails + 1)); else fails=0; fi
    sleep $(( fails > 5 ? 30 : 2 ))
done
